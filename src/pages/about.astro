---
import Layout from '../layouts/Layout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Feedback is sent by email (to the address registered with Web3Forms) through https://web3forms.com.
// 1. Go to https://web3forms.com, enter sajjad81@gmail.com, and copy the access key they email you.
// 2. Paste it below. (Web3Forms keys are meant to be public; they can only send mail to that address.)
const ACCESS_KEY = 'PASTE_WEB3FORMS_ACCESS_KEY_HERE';
const formActive = ACCESS_KEY !== 'PASTE_WEB3FORMS_ACCESS_KEY_HERE';
---
<Layout title="About the author · My Stories" description="About the author of My Stories, and a form to send feedback.">
  <a class="back" href={`${base}/`}>← Back to stories</a>

  <section class="panel">
    <div class="avatar" aria-hidden="true">✍️</div>
    <h1>About the author</h1>
    <p class="soon">🌱 Information will be updated soon.</p>
  </section>

  <section class="panel" id="feedback">
    <h2>💌 Send feedback</h2>
    <p class="muted">Liked a story? Have an idea? Tell me what you think.</p>

    <form id="feedback-form" novalidate>
      <input type="hidden" name="access_key" value={ACCESS_KEY} />
      <input type="hidden" name="subject" value="New feedback on My Stories" />
      <input type="hidden" name="from_name" value="My Stories website" />
      <!-- spam trap: real visitors never see or tick this -->
      <input type="checkbox" name="botcheck" class="trap" tabindex="-1" autocomplete="off" />

      <label for="fb-name">Your name <span class="muted">(optional)</span></label>
      <input id="fb-name" name="name" type="text" maxlength="60" autocomplete="name" />

      <label for="fb-email">Your email <span class="muted">(optional, only if you want a reply)</span></label>
      <input id="fb-email" name="email" type="email" maxlength="100" autocomplete="email" />

      <label for="fb-message">Your message</label>
      <textarea id="fb-message" name="message" rows="5" maxlength="1000" required></textarea>

      <button id="fb-send" type="submit" disabled={!formActive}>Send feedback</button>
      <p id="fb-status" role="status" aria-live="polite">
        {formActive ? '' : 'The feedback form will be switched on soon.'}
      </p>
    </form>
  </section>

  <script is:inline>
    const form = document.getElementById('feedback-form');
    const status = document.getElementById('fb-status');
    const send = document.getElementById('fb-send');
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = Object.fromEntries(new FormData(form));
      if (!data.message || !data.message.trim()) {
        status.textContent = 'Please write a message first 🙂';
        return;
      }
      if (data.botcheck) return; // bot
      send.disabled = true;
      status.textContent = 'Sending…';
      try {
        const res = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(data),
        });
        const json = await res.json();
        if (json.success) {
          form.reset();
          status.textContent = 'Thank you! Your feedback was sent 💖';
        } else {
          throw new Error(json.message || 'failed');
        }
      } catch {
        status.textContent = 'Sorry, something went wrong. Please try again later.';
      } finally {
        send.disabled = false;
      }
    });
  </script>

  <style>
    .back { display: inline-block; margin: .5rem 0 1rem; color: var(--accent); text-decoration: none; font-weight: 700; }
    .panel { background: var(--card); border: 1px solid var(--border); border-radius: 18px; padding: 1.5rem; margin-bottom: 1.5rem; max-width: 700px; }
    .panel h1, .panel h2 { margin-top: 0; color: var(--accent); }
    .avatar { width: 84px; height: 84px; border-radius: 50%; background: var(--accent-soft); display: grid; place-items: center; font-size: 2.4rem; margin-bottom: .5rem; }
    .soon { background: var(--accent-soft); border-radius: 12px; padding: .8rem 1rem; font-weight: 700; }
    .muted { color: var(--muted); font-weight: 500; }
    form { display: flex; flex-direction: column; gap: .4rem; }
    label { font-weight: 700; margin-top: .6rem; }
    input[type='text'], input[type='email'], textarea { font: inherit; padding: .6rem .8rem; border: 1px solid var(--border); border-radius: 12px; background: var(--bg); color: var(--text); }
    textarea { resize: vertical; }
    button[type='submit'] { margin-top: 1rem; align-self: flex-start; font: inherit; font-weight: 700; background: var(--accent); color: #fff; border: 0; border-radius: 999px; padding: .6rem 1.4rem; cursor: pointer; }
    button[type='submit']:disabled { opacity: .5; cursor: not-allowed; }
    .trap { position: absolute; left: -9999px; }
    #fb-status { min-height: 1.5rem; margin: .6rem 0 0; color: var(--muted); }
  </style>
</Layout>
