---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const stories = (await getCollection('stories')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const featured = stories.find((s) => s.data.featured) ?? stories[0];
const genres = [...new Set(stories.map((s) => s.data.genre))].sort();
const minutes = (body = '') => Math.max(1, Math.round(body.split(/\s+/).length / 200));
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---
<Layout>
  {featured && (
    <a class="hero" href={`${base}/stories/${featured.id}/`}>
      <div class="hero-emoji">{featured.data.emoji}</div>
      <div>
        <span class="tag">⭐ Featured · {featured.data.genre}</span>
        <h1>{featured.data.title}</h1>
        <p>{featured.data.summary}</p>
        <span class="read-btn">Read now →</span>
      </div>
    </a>
  )}

  <div class="controls">
    <input id="search" type="search" placeholder="🔍 Search stories..." />
    <div class="chips">
      <button class="chip active" data-genre="all">All</button>
      {genres.map((g) => <button class="chip" data-genre={g}>{g}</button>)}
    </div>
  </div>

  <div class="grid" id="grid">
    {stories.map((s) => (
      <a class="card" href={`${base}/stories/${s.id}/`} data-genre={s.data.genre} data-text={`${s.data.title} ${s.data.summary} ${s.data.genre}`.toLowerCase()}>
        <div class="card-emoji">{s.data.emoji}</div>
        <span class="tag">{s.data.genre}</span>
        <h3>{s.data.title}</h3>
        <p>{s.data.summary}</p>
        <small>{fmt(s.data.date)} · {minutes(s.body)} min read</small>
      </a>
    ))}
  </div>
  <p id="empty" hidden>No stories found 🙈</p>

  <script is:inline>
    const search = document.getElementById('search');
    const cards = [...document.querySelectorAll('.card')];
    const chips = [...document.querySelectorAll('.chip')];
    let genre = 'all';
    function apply() {
      const q = search.value.trim().toLowerCase();
      let shown = 0;
      cards.forEach((c) => {
        const ok = (genre === 'all' || c.dataset.genre === genre) && c.dataset.text.includes(q);
        c.hidden = !ok;
        if (ok) shown++;
      });
      document.getElementById('empty').hidden = shown > 0;
    }
    search.addEventListener('input', apply);
    chips.forEach((ch) => ch.addEventListener('click', () => {
      chips.forEach((x) => x.classList.remove('active'));
      ch.classList.add('active');
      genre = ch.dataset.genre;
      apply();
    }));
  </script>

  <style>
    .hero { display: flex; gap: 1.5rem; align-items: center; background: linear-gradient(135deg, var(--accent-soft), var(--card)); border: 1px solid var(--border); border-radius: 24px; padding: 2rem; text-decoration: none; margin: 1rem 0 2rem; }
    .hero-emoji { font-size: 5rem; }
    .hero h1 { margin: .3rem 0; font-size: 2rem; }
    .hero p { margin: 0 0 1rem; color: var(--muted); }
    .read-btn { background: var(--accent); color: #fff; padding: .5rem 1.2rem; border-radius: 999px; font-weight: 700; display: inline-block; }
    .tag { background: var(--accent-soft); color: var(--accent); font-size: .8rem; font-weight: 700; padding: .15rem .7rem; border-radius: 999px; }
    .controls { display: flex; flex-wrap: wrap; gap: 1rem; align-items: center; margin-bottom: 1.5rem; }
    #search { flex: 1 1 220px; padding: .7rem 1rem; border-radius: 999px; border: 1px solid var(--border); background: var(--card); color: var(--text); font: inherit; }
    .chips { display: flex; flex-wrap: wrap; gap: .5rem; }
    .chip { border: 1px solid var(--border); background: var(--card); color: var(--text); padding: .4rem 1rem; border-radius: 999px; cursor: pointer; font: inherit; }
    .chip.active { background: var(--accent); color: #fff; border-color: var(--accent); }
    .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 1.2rem; }
    .card { background: var(--card); border: 1px solid var(--border); border-radius: 20px; padding: 1.4rem; text-decoration: none; transition: transform .2s, box-shadow .2s; }
    .card:hover { transform: translateY(-4px); box-shadow: 0 10px 24px rgba(0,0,0,.1); }
    .card[hidden] { display: none; }
    .card-emoji { font-size: 2.8rem; }
    .card h3 { margin: .5rem 0 .3rem; }
    .card p { color: var(--muted); margin: 0 0 .8rem; }
    .card small { color: var(--muted); }
    #empty { text-align: center; color: var(--muted); }
    @media (max-width: 600px) { .hero { flex-direction: column; text-align: center; } }
  </style>
</Layout>
